set_option maxHeartbeats 4000000

theorem candidate_unit : ∀ i, ‖candidate i‖ = 1 := candidate_norm

theorem dist_of_inv_le {d : R3} {u : ℝ} (hu : u ≤ 25/16) (h : ‖d‖⁻¹ ≤ u) (hpos : 0 < ‖d‖⁻¹) :
    (16/25 : ℝ) ≤ ‖d‖ := by
  have hd : 0 < ‖d‖ := inv_pos.mp hpos
  have h' : ‖d‖⁻¹ ≤ 25/16 := h.trans hu
  rw [inv_le_comm₀ hd (by norm_num)] at h'
  linarith [show (16/25 : ℝ) ≤ (25/16 : ℝ)⁻¹ by norm_num]

theorem candidate_distance : ∀ i j : Fin 32, i < j → (16/25 : ℝ) ≤ ‖candidate i - candidate j‖ := by
