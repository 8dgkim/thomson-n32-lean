theorem hNum_getD (i : Fin 33) : hNum.getD i 0 = hNumR i := by
  fin_cases i <;> rfl

theorem hNewCoeff_eq (i : Fin 33) : (hNewCoeff i : ℝ) = (hNumR i : ℝ) / 10 ^ 60 := by
  fin_cases i <;> simp [hNewCoeff, hNumR] <;> norm_num

theorem rawEnergyReduced_eq_energyUpper : rawEnergyReduced = Thomson32.energyUpper := by
